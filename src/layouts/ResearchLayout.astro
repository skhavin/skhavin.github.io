---
import '../styles/research.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Research Archive — S. Khavin',
  description = 'S. Khavin — Independent researcher working on mechanistic interpretability, computational geometry, and efficient inference.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://skhavin.github.io/" />
    <link rel="canonical" href="https://skhavin.github.io/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <link rel="preload" href="/fonts/GoldenEye.ttf" as="font" type="font/ttf" crossorigin />
    <link
      rel="preload"
      href="https://skhavin.in/assets/fonts/PPEditorialNew-UltralightItalic.otf"
      as="font"
      type="font/otf"
      crossorigin
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=Libertinus+Mono&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
