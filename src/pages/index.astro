  <script>
    import {
      fetchPublications,
      parsePublicationsPayload,
      toBibtex,
      type Publication,
    } from '../lib/publications';
    import { renderGroupedResearchHtml } from '../lib/render';

    type ThemeFilter = 'all' | 'geometry' | 'inference' | 'multimodal';
    type SheetTab = 'all' | 'research' | 'bio' | 'record';

    const ssrEl = document.getElementById('ssr-publications');
    let initialPayload: unknown = { publications: [] };
    if (ssrEl?.textContent) {
      try {
        initialPayload = JSON.parse(ssrEl.textContent);
      } catch {
        initialPayload = { publications: [] };
      }
    }

    const state = {
      publications: parsePublicationsPayload(initialPayload) as Publication[],
      theme: 'all' as ThemeFilter,
      query: '',
      tab: 'all' as SheetTab,
    };

    const containerEl = document.getElementById('research-themes-container');
    const filtersEl = document.getElementById('theme-filters');
    const searchEl = document.getElementById('research-search') as HTMLInputElement | null;
    const syncNoteEl = document.getElementById('sync-note');
    const themeBtnEl = document.getElementById('theme-toggle');
    const sheetTabsEl = document.getElementById('sheet-tabs');
    const researchTabBtn = document.getElementById('tab-research-btn');

    let katexPromise: Promise<void> | null = null;

    function maybeLoadAndTypesetMath(root: HTMLElement | null): void {
      if (!root) return;
      const text = root.textContent ?? '';
      if (!/\$[A-Za-z\\][^$\n]{0,80}\$|\\\(|\\\[/.test(text)) return;

      const win = window as unknown as {
        renderMathInElement?: (el: HTMLElement, opts: Record<string, unknown>) => void;
      };

      const applyMath = () => {
        if (typeof win.renderMathInElement === 'function') {
          win.renderMathInElement(root, {
            delimiters: [
              { left: '$$', right: '$$', display: true },
              { left: '$', right: '$', display: false },
              { left: '\\(', right: '\\)', display: false },
            ],
            ignoredClasses: ['no-math'],
            throwOnError: false,
          });
        }
      };

      if (typeof win.renderMathInElement === 'function') {
        applyMath();
        return;
      }

      if (!katexPromise) {
        katexPromise = new Promise<void>((resolve) => {
          const css = document.createElement('link');
          css.rel = 'stylesheet';
          css.href = 'https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css';
          document.head.appendChild(css);

          const core = document.createElement('script');
          core.src = 'https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js';
          core.onload = () => {
            const auto = document.createElement('script');
            auto.src = 'https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js';
            auto.onload = () => resolve();
            auto.onerror = () => resolve();
            document.head.appendChild(auto);
          };
          core.onerror = () => resolve();
          document.head.appendChild(core);
        });
      }

      void katexPromise.then(applyMath);
    }

    function syncThemeButton(): void {
      const current =
        document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
      if (themeBtnEl) {
        themeBtnEl.textContent = current === 'dark' ? 'Light' : 'Dark';
      }
    }

    function applySheetTab(tab: SheetTab): void {
      state.tab = tab;
      sheetTabsEl?.querySelectorAll<HTMLButtonElement>('[data-sheet-tab]').forEach((btn) => {
        const active = btn.dataset.sheetTab === tab;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-selected', active ? 'true' : 'false');
      });

      document.querySelectorAll<HTMLElement>('[data-sheet-panel]').forEach((panel) => {
        panel.hidden = tab !== 'all' && panel.dataset.sheetPanel !== tab;
      });
    }

    function renderResearch(): void {
      filtersEl?.querySelectorAll<HTMLButtonElement>('[data-theme-filter]').forEach((btn) => {
        btn.classList.toggle('is-active', btn.dataset.themeFilter === state.theme);
      });

      if (containerEl) {
        containerEl.innerHTML = renderGroupedResearchHtml(
          state.publications,
          state.theme,
          state.query
        );
        maybeLoadAndTypesetMath(containerEl);
      }
    }

    async function syncFromMainSite(): Promise<void> {
      const result = await fetchPublications(
        { publications: state.publications },
        { timeoutMs: 5000, noCache: true }
      );

      if (result.publications.length > 0) {
        state.publications = result.publications;
        if (researchTabBtn) {
          researchTabBtn.textContent = `Research (${state.publications.length})`;
        }
      }

      if (syncNoteEl) {
        syncNoteEl.textContent =
          result.source === 'live'
            ? 'Synchronized live with skhavin.in/publications.json'
            : 'Local snapshot active (skhavin.in unreachable or CORS pending)';
      }

      if (result.source === 'live') {
        renderResearch();
      }
    }

    themeBtnEl?.addEventListener('click', () => {
      const current =
        document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try {
        localStorage.setItem('skhavin-theme', next);
      } catch {
        // Ignore restricted storage contexts.
      }
      syncThemeButton();
    });

    sheetTabsEl?.addEventListener('click', (event) => {
      const btn = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-sheet-tab]');
      if (!btn) return;
      const val = btn.dataset.sheetTab as SheetTab | undefined;
      if (val) applySheetTab(val);
    });

    // If user clicks an anchor in the topbar while on a filtered tab, switch back to Overview.
    document.querySelectorAll<HTMLAnchorElement>('.topbar-nav a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener('click', () => {
        if (state.tab !== 'all') applySheetTab('all');
      });
    });

    filtersEl?.addEventListener('click', (event) => {
      const btn = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-theme-filter]');
      if (!btn) return;
      const val = btn.dataset.themeFilter as ThemeFilter | undefined;
      if (!val) return;
      state.theme = val;
      renderResearch();
    });

    searchEl?.addEventListener('input', () => {
      state.query = searchEl.value;
      renderResearch();
    });

    containerEl?.addEventListener('click', async (event) => {
      const target = event.target as HTMLElement;

      if (target.closest('[data-reset-research]')) {
        state.theme = 'all';
        state.query = '';
        if (searchEl) searchEl.value = '';
        renderResearch();
        return;
      }

      const citeBtn = target.closest<HTMLButtonElement>('[data-cite-id]');
      if (citeBtn) {
        const pub = state.publications.find((p) => p.id === citeBtn.dataset.citeId);
        if (!pub) return;
        try {
          await navigator.clipboard.writeText(toBibtex(pub));
          citeBtn.textContent = 'Copied BibTeX';
          setTimeout(() => {
            citeBtn.textContent = 'BibTeX';
          }, 1500);
        } catch {
          citeBtn.textContent = 'Copy unavailable';
        }
      }
    });

    syncThemeButton();
    maybeLoadAndTypesetMath(containerEl);
    void syncFromMainSite();
  </script>
</ResearchLayout>
