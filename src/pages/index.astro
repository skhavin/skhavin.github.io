  <!-- 1. Black Blurry Navbar (links on right, clean) -->
  <nav id="mainNav" class="site-nav">
    <div class="nav-left">
      <a class="nav-logo" href="#top">
        <span class="nav-bond-icon" aria-hidden="true">
          <svg viewBox="0 0 945 945" width="15" height="15" fill="currentColor">
