    </div>

    <ul class="nav-center">
      <li>
        <a href="https://skhavin.in/research" target="_blank" rel="noopener noreferrer">
          <span class="nav-num">I.</span>
          <span class="nav-label">RESEARCH</span>
        </a>
      </li>
      <li>
        <a href="#bio" class="active">
          <span class="nav-num">II.</span>
          <span class="nav-label">DOSSIER</span>
        </a>
      </li>
      <li>
        <a href="https://skhavin.in/blog" target="_blank" rel="noopener noreferrer">
          <span class="nav-num">III.</span>
          <span class="nav-label">NOTES</span>
        </a>
      </li>
    </ul>

    <div class="nav-right">
      <div class="nav-iff-status">
        <span class="iff-dot" aria-hidden="true"></span>
        <span>IFF // MODE 5</span>
      </div>
      <button type="button" class="nav-burger" id="burgerBtn" aria-label="Menu">
        <span></span><span></span>
      </button>
    </div>
  </nav>

  <div class="mob-menu" id="mobMenu">
    <a href="https://skhavin.in/research" target="_blank" rel="noopener noreferrer">I. RESEARCH</a>
    <a href="#bio" id="mobBioLink">II. DOSSIER</a>
    <a href="https://skhavin.in/blog" target="_blank" rel="noopener noreferrer">III. NOTES</a>
  </div>

  <!-- 2. Gunbarrel + S Khavin (~55px below) -->
  <section class="gunbarrel-band" id="top">
    <div class="gunbarrel-stage">
      <img
        src="/hero_circular_albedo.webp"
        onerror="this.onerror=null;this.src='https://skhavin.in/hero_circular_albedo.webp';"
        alt="007 Gunbarrel"
        class="gunbarrel-img"
      />
      <div class="center-stack">
        <span class="text-skhavin">S+KHAVIN</span>
      </div>
    </div>
  </section>

  <!-- 3 & 4. White bg black text: left "S. Khavin is a ...", right photo -->
  <main class="bio-section" id="bio">
    <div class="bio-container">
      <div class="bio-grid">
        <div class="bio-text-col">
          <h1 class="bio-heading">S+KHAVIN</h1>
          <div class="bio-copy">
            <p>
              <strong>S. Khavin</strong> is a final-year Computer Science Engineering student at
              Sathyabama Institute of Science and Technology, Chennai, and an independent researcher
              studying mechanistic interpretability, computational geometry in residual streams, and
              training-free efficient inference.
            </p>
            <p>
              His work examines which circuits and directions inside language and vision-language
              models are causally necessary versus geometrically epiphenomenal, using those findings
              for zero-training sparse routing, proactive O(1) KV-cache eviction, and linear-time
              video memory graphs.
            </p>
          </div>
          <div class="bio-links">
            <a href="https://openreview.net/profile?id=~S_Khavin1" target="_blank" rel="noopener noreferrer">OpenReview</a>
            <a href="https://github.com/skhavin" target="_blank" rel="noopener noreferrer">GitHub</a>
            <a href="https://skhavin.in" target="_blank" rel="noopener noreferrer">skhavin.in</a>
            <a href="mailto:skhavin.res@gmail.com">skhavin.res@gmail.com</a>
          </div>
        </div>

        <div class="bio-photo-col">
          <img
            src="/portrait.jpg"
            onerror="this.onerror=null;this.src='https://skhavin.in/assets/profile_1.jpg';"
            alt="S. Khavin"
            class="bio-photo"
          />
        </div>
      </div>
    </div>
  </main>

  <!-- 5. Blur overlay fixed to bottom of screen -->
  <div class="bottom-blur-overlay" aria-hidden="true"></div>

  <script>
    const burgerBtn = document.getElementById('burgerBtn');
    const mobMenu = document.getElementById('mobMenu');
    const mobBioLink = document.getElementById('mobBioLink');

    burgerBtn?.addEventListener('click', () => {
      mobMenu?.classList.toggle('open');
    });

    mobBioLink?.addEventListener('click', () => {
      mobMenu?.classList.remove('open');
    });
  </script>
</ResearchLayout>
