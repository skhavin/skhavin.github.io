---
import ResearchLayout from '../layouts/ResearchLayout.astro';
import fallbackPayload from '../data/publications.fallback.json';
import {
  MAIN_SITE_ORIGIN,
  REMOTE_PUBLICATIONS_URL,
  fetchPublications,
  sortPublications,
} from '../lib/publications';
import { renderGroupedResearchHtml } from '../lib/render';

const { publications: fetchedPublications, source: initialSource } = await fetchPublications(
  fallbackPayload,
  { timeoutMs: 2200 }
);

const initialPublications = sortPublications(fetchedPublications);
const serializedPayload = JSON.stringify({ publications: initialPublications }).replace(
  /</g,
  '\\u003c'
);
