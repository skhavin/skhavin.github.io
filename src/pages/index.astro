---
import ResearchLayout from '../layouts/ResearchLayout.astro';

interface PreprintLink {
  label: string;
  url: string;
}

interface Preprint {
  index: string;
  category: 'interpretability' | 'geometry' | 'efficiency';
  date: string;
  venue: string;
  title: string;
  summary: string;
  abstract: string;
  links: PreprintLink[];
}

const PREPRINTS: Preprint[] = [
  {
    index: '01',
    category: 'interpretability',
    date: 'Aug 2026',
    venue: 'OpenReview · Zenodo',
    title: 'K Heads is All You Need: Task-Dependent Circuit Granularity and Zero-Training Routing in LLMs',
    summary:
      'Isolates a 6-head retrieval circuit in Qwen2.5 and builds a training-free cosine router validated on NVIDIA RULER 4K.',
    abstract:
      'Shows needle-in-a-haystack retrieval in Qwen2.5-1.5B relies on a 6-head causal circuit against layer-matched controls, maps where algorithmic tasks resist sparsification, and introduces an early-layer cosine router with zero false activations on 100 OOD samples.',
    links: [
      { label: 'OpenReview', url: 'https://openreview.net/forum?id=eFLz0H38En' },
      { label: 'Zenodo', url: 'https://zenodo.org/records/22082191' },
    ],
  },
  {
    index: '02',
    category: 'geometry',
    date: 'Aug 2026',
    venue: 'Zenodo',
    title: 'The Shape of Computation: Universal, Conserved Task Geometries That Are Causally Inert',
    summary:
      'Uncovers CKA-DTW conserved trunk-and-branch manifolds built by MLPs and shows they are causally inert under steering controls.',
    abstract:
      'Eliminates embedding template leakage across three models to isolate conserved task trajectories via PCA and CKA-DTW alignment, showing magnitude-matched steering fails to generalize and geometry is an epiphenomenal byproduct.',
    links: [
      { label: 'Zenodo', url: 'https://zenodo.org/records/21738187' },
      { label: 'Note', url: 'https://skhavin.in/blog/trunk-and-branch-theory-of-computation' },
    ],
  },
  {
    index: '03',
    category: 'geometry',
    date: 'Jul 2026',
    venue: 'OpenReview · Zenodo',
    title: 'Necessary but Not Sufficient: Convergent Computational Geometry in the Transformer Residual Stream',
    summary:
      'Finds conserved relational geometry across 3 architectures (ρ = 0.38–0.75) that is necessary on ablation yet insufficient for steering.',
    abstract:
      'Across 12 operations in Qwen2.5, Llama-3.2, and Phi-1.5, residual relational geometry aligns via Procrustes after confound regression (Mantel p < 0.003); ablation selectively impairs tasks while additive steering fails to induce them.',
    links: [
      { label: 'OpenReview', url: 'https://openreview.net/forum?id=PZOx6oz6TT' },
      { label: 'Zenodo', url: 'https://zenodo.org/records/21300225' },
    ],
  },
  {
    index: '04',
    category: 'interpretability',
    date: 'Jul 2026',
    venue: 'OpenReview · Zenodo',
    title: 'The HeadGenome Taxonomy: A Structural and Causal Map of Attention Head Specialization',
    summary:
      'Maps 1,568 heads across 4 architectures into 4 functional classes and achieves 13.3× KV-cache compression over StreamingLLM.',
    abstract:
      'Classifies 1,568 heads across GPT-2 Medium, Qwen-2.5, and Llama-3.2 into Sink, Local, Retrieval, and Induction classes, uncovering a norm depth scaling law (p = 1.92 × 10⁻¹²⁷) and zero-degradation KV compression.',
    links: [
      { label: 'OpenReview', url: 'https://openreview.net/forum?id=iG4i2pc4wg' },
      { label: 'Zenodo', url: 'https://zenodo.org/records/21108324' },
      { label: 'Code', url: 'https://github.com/skhavin/headgenome' },
      { label: 'Site', url: 'https://skhavin.github.io/attentionheadgenome/' },
    ],
  },
  {
    index: '05',
    category: 'efficiency',
    date: 'May 2026',
    venue: 'Zenodo · OpenReview',
    title: 'O(1) Decode Step Attention for Any Transformer via Training-Free Proactive KV Cache Eviction',
    summary:
      'Predicts relevant KV prototypes proactively at ingest for O(1) decode attention, achieving 3.09× speedup on LLaMA 3.1 8B.',
    abstract:
      'Clusters per-head attention prototypes offline and predicts keys via TF-IDF before query arrival, bounding cache size to fixed budget B (PPL 10.25 vs. 47.34 for StreamingLLM on LLaMA 3.1 8B at 3.09× decode speedup).',
    links: [
      { label: 'Zenodo', url: 'https://zenodo.org/records/20465915' },
    ],
  },
  {
    index: '06',
    category: 'efficiency',
    date: 'Mar 2026',
    venue: 'OpenReview · Zenodo',
    title: 'Trinetra: O(N) Video Ingest, O(1) Query — A Proactive Temporal Event Graph for Long Video',
    summary:
      'Replaces O(T²) video re-processing with dual-FAISS temporal event graphs for 9× temporal gain and 317,500× fewer query FLOPs.',
    abstract:
      'Combines Temporal Event Graphs, multi-scale Temporal Attention Shift (TAS₂, TAS₈, TAS₃₂), and dual FAISS indexing for linear ingest and constant-time query across long-form video.',
    links: [
      { label: 'OpenReview', url: 'https://openreview.net/forum?id=jUtTzSVplk' },
      { label: 'Zenodo', url: 'https://zenodo.org/records/19144365' },
    ],
  },
];

const FILTERS = [
  { id: 'all', label: 'All (06)' },
  { id: 'interpretability', label: 'Interpretability' },
  { id: 'geometry', label: 'Geometry' },
  { id: 'efficiency', label: 'Efficient Inference' },
];

const EXPERIENCE = [
  { period: '2025', role: 'SWE Co-Op Intern', org: 'AlgoUniversity (YC)' },
  { period: '2024', role: 'Team Lead · National Top Project', org: 'Google GenAI Hackathon' },
  { period: '2024', role: 'ML Research Intern (Co-Lead)', org: 'Omdena' },
  { period: '2024', role: 'AI & Automation Intern', org: 'Chennai Airport' },
  { period: '2023', role: 'Business Analytics Intern', org: 'Business.io · IITM' },
];

const RECOGNITION = [
  { period: '2024', title: 'AlgoUniversity Technology Fellowship', detail: 'Top 5% of 20,000 applicants nationwide' },
  { period: '2023', title: 'Udacity Next Gen Tech Booster Scholarship', detail: '1 of 500 selected from 17,000 global applicants' },
  { period: '2024', title: 'National Entrepreneurship Challenge · IIT Bombay', detail: '5th Place nationwide' },
];
---

