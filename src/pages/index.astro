---
import ResearchLayout from '../layouts/ResearchLayout.astro';
import {
  SITE_LINKS,
  FEATURED_PAPER,
  PREPRINTS,
  WRITING_ENTRIES,
  SELECTED_EXPERIENCE,
  SELECTED_AWARDS,
} from '../data/research';

const homepageWriting = WRITING_ENTRIES.slice(0, 2);
const totalPaperCount = PREPRINTS.length + 1;
---

<ResearchLayout
  title="S. Khavin — Independent Research & Preprints"
  description="Mechanistic interpretability, representation geometry, and training-free efficient inference by S. Khavin."
  activePage="home"
>
  <!-- 2. Full Editorial Gunbarrel Hero -->
  <section class="gunbarrel-band" id="top">
    <div class="gunbarrel-stage">
      <img
        src="/hero_circular_albedo.webp"
        onerror="this.onerror=null;this.src='https://skhavin.in/hero_circular_albedo.webp';"
        alt="007 Gunbarrel"
        class="gunbarrel-img"
      />
      <header class="center-stack">
        <h1 class="text-skhavin">S+KHAVIN</h1>
        <p class="hero-role">
          Independent Researcher — Mechanistic Interpretability &amp; Efficient Inference
        </p>
        <div class="hero-cta-row">
          <a href="#research" class="hero-cta">Explore Research ↗</a>
          <a href="#about" class="hero-cta">About Me ↗</a>
        </div>
      </header>
    </div>
  </section>

  <!-- 3. White Editorial Body -->
  <main class="research-main">
    <!-- Section I: Editorial About (Full) -->
    <section class="bio-section" id="about">
      <div class="archive-header">
        <div class="archive-title">Research Archive - S Khavin</div>
        <div class="archive-rule"></div>
        <div class="page-container">
          <h2 class="plus-about-text">+About</h2>
        </div>
        <div class="archive-rule"></div>
      </div>

      <div class="page-container bio-grid-wrap">
        <div class="bio-grid">
          <div class="bio-text-col">
            <div class="bio-copy">
              <p>
                <strong>S. Khavin</strong> is a final-year Computer Science Engineering student at
                Sathyabama Institute of Science and Technology, Chennai, and an independent
                researcher studying mechanistic interpretability, computational geometry in residual
                streams, and training-free efficient inference.
              </p>
              <p>
                His work tests which circuits and representations inside language and
                vision-language models are causally necessary versus geometrically epiphenomenal,
                using those maps for zero-training sparse routing, proactive O(1) KV-cache eviction,
                and linear-time video memory graphs.
              </p>
            </div>

            <p class="bio-editorial-line">A curiosity for what lies beneath.</p>

            <div class="bio-meta">
              <div class="bio-meta-group">
                <div class="bio-meta-label">Affiliation</div>
                <div class="bio-meta-primary">Sathyabama Institute of Science and Technology</div>
                <div class="bio-meta-sub">B.E. CSE · 2023–2027 · Chennai</div>
              </div>
              <div class="bio-meta-group">
                <div class="bio-meta-label">Research</div>
                <ul class="bio-focus-list">
                  <li><span class="focus-idx">01</span><span>Mechanistic Interpretability</span></li>
                  <li><span class="focus-idx">02</span><span>Representation Geometry</span></li>
                  <li><span class="focus-idx">03</span><span>Efficient Inference</span></li>
                </ul>
              </div>
            </div>

            <nav class="bio-links" aria-label="Research links">
              <a href={SITE_LINKS.openReview} target="_blank" rel="noopener noreferrer">OpenReview ↗</a>
              <a href={SITE_LINKS.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
              <a href={SITE_LINKS.mainSite} target="_blank" rel="noopener noreferrer">skhavin.in ↗</a>
              <a href="/cv">CV →</a>
              <a href={`mailto:${SITE_LINKS.email}`}>{SITE_LINKS.email}</a>
            </nav>
          </div>

          <div class="bio-photo-col">
            <figure class="bio-figure">
              <img
                src="/portrait.jpg"
                onerror="this.onerror=null;this.src='https://skhavin.in/assets/profile_1.jpg';"
                alt="S. Khavin"
                class="bio-photo"
              />
            </figure>
          </div>
        </div>
      </div>
    </section>

    <!-- Section II: Research (Full Featured Paper + Compact Preprints List) -->
    <section class="archive-band" id="research">
      <div class="page-container section-band-inner">
        <div class="section-divider"></div>

        <div class="section-head-row reveal-el">
          <h2 class="section-editorial-title">Research</h2>
          <a href="/archive" class="section-ext-link">Full archive →</a>
        </div>

        <!-- Featured Research (Full, no card box) -->
        <article class="featured-paper reveal-el">
          <div class="featured-eyebrow">FEATURED RESEARCH · {FEATURED_PAPER.date}</div>

          <figure class="featured-figure">
            <img
              src={FEATURED_PAPER.image}
              onerror={`this.onerror=null;this.src='${FEATURED_PAPER.fallbackImage}';`}
              alt={FEATURED_PAPER.title}
              class="featured-img"
            />
            <figcaption class="featured-caption">{FEATURED_PAPER.caption}</figcaption>
          </figure>

          <h3 class="featured-title">{FEATURED_PAPER.title}</h3>
          <p class="featured-oneliner">{FEATURED_PAPER.oneLiner}</p>

          <div class="featured-abstract">
            {FEATURED_PAPER.abstractParagraphs.map((para) => (
              <p>{para}</p>
            ))}
          </div>

          <div class="featured-links">
            <span class="paper-venue">{FEATURED_PAPER.venue}</span>
            <div class="paper-link-group">
              {FEATURED_PAPER.links.map((link) => (
                <a href={link.url} target="_blank" rel="noopener noreferrer">
                  {link.label} ↗
                </a>
              ))}
            </div>
          </div>
        </article>

        <!-- Other Preprints (Compact List) -->
        <div class="archive-subhead reveal-el">
          Selected Preprints ({String(PREPRINTS.length).padStart(2, '0')})
        </div>

        <ul class="papers-list papers-compact-list">
          {PREPRINTS.map((paper) => (
            <li class="paper-compact-row reveal-el">
              <div class="paper-compact-date">{paper.date}</div>
              <div class="paper-compact-body">
                <span class="paper-compact-title">{paper.title}.</span>
                <span class="paper-link-group paper-inline-links">
                  {paper.links.map((link) => (
                    <a href={link.url} target="_blank" rel="noopener noreferrer">
                      ({link.label})
                    </a>
                  ))}
                </span>
              </div>
            </li>
          ))}
        </ul>

        <div class="archive-more-wrap reveal-el">
          <a href="/archive" class="archive-more-link">
            View full research archive (all {totalPaperCount} papers) →
          </a>
        </div>
      </div>
    </section>

    <!-- Section III: Writing (1-2 Entries) -->
    <section class="archive-band" id="blog">
      <div class="page-container section-band-inner">
        <div class="section-divider"></div>

        <div class="section-head-row reveal-el">
          <h2 class="section-editorial-title">Writing</h2>
          <a
            href={SITE_LINKS.blogExternal}
            target="_blank"
            rel="noopener noreferrer"
            class="section-ext-link"
          >
            All field notes ↗
          </a>
        </div>

        <ul class="blog-list">
          {homepageWriting.map((post) => (
            <li class="blog-row reveal-el">
              <div class="blog-tag">{post.tag}</div>
              <div class="blog-body">
                <h3 class="blog-title">
                  <a href={post.url} target="_blank" rel="noopener noreferrer">
                    {post.title}
                  </a>
                </h3>
                <p class="blog-desc">{post.description}</p>
              </div>
              <a
                href={post.url}
                target="_blank"
                rel="noopener noreferrer"
                class="blog-cta"
              >
                {post.cta}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Section IV: Experience (Selected Entries) -->
    <section class="archive-band archive-band-last" id="experience">
      <div class="page-container section-band-inner">
        <div class="section-divider"></div>

        <div class="section-head-row reveal-el">
          <h2 class="section-editorial-title">Experience</h2>
          <a href="/cv" class="section-ext-link">Full CV →</a>
        </div>

        <div class="ledger-grid">
          <div class="ledger-col reveal-el">
            <h3 class="ledger-subhead">Research &amp; Engineering</h3>
            <ul class="ledger-list">
              {SELECTED_EXPERIENCE.map((item) => (
                <li class="ledger-row">
                  <span class="ledger-period">{item.period}</span>
                  <div class="ledger-text">
                    <span class="ledger-primary">{item.primary}</span>
                    <span class="ledger-secondary">{item.detail}</span>
                  </div>
                </li>
              ))}
            </ul>
          </div>

          <div class="ledger-col reveal-el">
            <h3 class="ledger-subhead">Selected Recognition</h3>
            <ul class="ledger-list">
              {SELECTED_AWARDS.map((item) => (
                <li class="ledger-row">
                  <span class="ledger-period">{item.period}</span>
                  <div class="ledger-text">
                    <span class="ledger-primary">{item.primary}</span>
                    <span class="ledger-secondary">{item.detail}</span>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="archive-more-wrap reveal-el">
          <a href="/cv" class="archive-more-link">
            View complete curriculum vitae →
          </a>
        </div>
      </div>
    </section>
  </main>
</ResearchLayout>
