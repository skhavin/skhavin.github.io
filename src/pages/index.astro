  <!-- 2. Tall, Heavily Zoomed Gunbarrel Hero Starting From Top Rim -->
  <section class="gunbarrel-band" id="top">
    <div class="gunbarrel-stage">
      <img
        src="/hero_circular_albedo.webp"
        onerror="this.onerror=null;this.src='https://skhavin.in/hero_circular_albedo.webp';"
        alt="007 Gunbarrel"
        class="gunbarrel-img"
      />
      <div class="center-stack">
        <span class="text-skhavin">S+KHAVIN</span>
      </div>
    </div>
  </section>

  <!-- 3. White Editorial Body -->
  <main class="research-main">
    <!-- Section I: Centered Title, Hairline Rules, Left +About, Bio & Portrait -->
    <section class="bio-section" id="about">
      <header class="archive-header">
        <h1 class="archive-title">Research Archive - S Khavin</h1>
        <div class="archive-rule"></div>
        <div class="page-container">
          <h2 class="plus-about-text">+About</h2>
        </div>
        <div class="archive-rule"></div>
      </header>

      <div class="page-container bio-grid-wrap">
        <div class="bio-grid">
          <div class="bio-text-col">
            <div class="bio-copy">
              <p>
                <strong>S. Khavin</strong> is a final-year Computer Science Engineering student at
                Sathyabama Institute of Science and Technology, Chennai, and an independent researcher
                studying mechanistic interpretability, computational geometry in residual streams, and
                training-free efficient inference.
              </p>
              <p>
                His work tests which circuits and representations inside language and vision-language
                models are causally necessary versus geometrically epiphenomenal, using those maps for
                zero-training sparse routing, proactive O(1) KV-cache eviction, and linear-time video
                memory graphs.
              </p>
            </div>

            <div class="bio-meta">
              <div class="bio-meta-group">
                <div class="bio-meta-label">Affiliation</div>
                <div class="bio-meta-primary">Sathyabama Institute of Science and Technology</div>
                <div class="bio-meta-sub">B.E. CSE · 2023–2027 · Chennai</div>
              </div>
              <div class="bio-meta-group">
                <div class="bio-meta-label">Research</div>
                <ul class="bio-focus-list">
                  <li><span class="focus-idx">01</span><span>Mechanistic Interpretability</span></li>
                  <li><span class="focus-idx">02</span><span>Representation Geometry</span></li>
                  <li><span class="focus-idx">03</span><span>Efficient Inference</span></li>
                </ul>
              </div>
            </div>

            <nav class="bio-links" aria-label="Research links">
              <a href="https://openreview.net/profile?id=~S_Khavin1" target="_blank" rel="noopener noreferrer">OpenReview ↗</a>
              <a href="https://github.com/skhavin" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
              <a href="https://skhavin.in" target="_blank" rel="noopener noreferrer">skhavin.in ↗</a>
              <a href="mailto:skhavin.res@gmail.com">skhavin.res@gmail.com</a>
            </nav>
          </div>

          <div class="bio-photo-col">
            <figure class="bio-figure">
              <img
                src="/portrait.jpg"
                onerror="this.onerror=null;this.src='https://skhavin.in/assets/profile_1.jpg';"
                alt="S. Khavin"
                class="bio-photo"
              />
              <figcaption class="bio-caption">S. KHAVIN · CHENNAI, INDIA</figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <!-- Section II: Compact Preprints List -->
    <section class="archive-band" id="preprints">
      <div class="archive-rule"></div>
      <div class="page-container section-band-inner">
        <div class="section-head-row">
          <div>
            <div class="section-kicker">01 // WORKING PAPERS</div>
            <h2 class="section-goldeneye-title">Selected Preprints</h2>
          </div>
          <div class="filter-bar" role="group" aria-label="Filter preprints by area">
            {FILTERS.map((f, i) => (
              <button
                type="button"
                class={`filter-btn ${i === 0 ? 'active' : ''}`}
                data-filter={f.id}
              >
                {f.label}
              </button>
            ))}
          </div>
        </div>

        <ol class="papers-list" id="papersList">
          {PREPRINTS.map((paper) => (
            <li class="paper-row" data-category={paper.category}>
              <div class="paper-idx-col">
                <span class="paper-idx">{paper.index}</span>
                <span class="paper-date">{paper.date}</span>
              </div>
              <div class="paper-body">
                <h3 class="paper-title">
                  <a href={paper.links[0]?.url} target="_blank" rel="noopener noreferrer">
                    {paper.title}
                  </a>
                </h3>
                <p class="paper-summary">{paper.summary}</p>
                <div class="paper-meta-bar">
                  <span class="paper-venue">{paper.venue}</span>
                  <div class="paper-link-group">
                    {paper.links.map((link) => (
                      <a href={link.url} target="_blank" rel="noopener noreferrer">
                        {link.label} ↗
                      </a>
                    ))}
                  </div>
                  <details class="paper-details">
                    <summary>Abstract</summary>
                    <p class="paper-abstract">{paper.abstract}</p>
                  </details>
                </div>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Section III: Blog Linking to Main Website -->
    <section class="archive-band" id="blog">
      <div class="archive-rule"></div>
      <div class="page-container section-band-inner">
        <div class="section-head-row">
          <div>
            <div class="section-kicker">02 // FIELD NOTES ON SKHAVIN.IN</div>
            <h2 class="section-goldeneye-title">Blog</h2>
          </div>
          <a
            href="https://skhavin.in/blog"
            target="_blank"
            rel="noopener noreferrer"
            class="section-ext-link"
          >
            ALL FIELD NOTES (skhavin.in/blog) ↗
          </a>
        </div>

        <div class="blog-list">
          <a
            href="https://skhavin.in/blog/trunk-and-branch-theory-of-computation"
            target="_blank"
            rel="noopener noreferrer"
            class="blog-row"
          >
            <span class="blog-tag">ESSAY 01</span>
            <div class="blog-row-body">
              <h3 class="blog-row-title">The Trunk and Branch Theory of Computation</h3>
              <p class="blog-row-desc">
                Why task representations diverge progressively from a shared semantic trunk across
                architectures—and what null steering controls tell us about causal readouts.
              </p>
            </div>
            <span class="blog-arrow">Read ↗</span>
          </a>

          <a
            href="https://skhavin.in/blog"
            target="_blank"
            rel="noopener noreferrer"
            class="blog-row"
          >
            <span class="blog-tag">ARCHIVE</span>
            <div class="blog-row-body">
              <h3 class="blog-row-title">Field Notes — Ideas, Experiments &amp; Working Fragments</h3>
              <p class="blog-row-desc">
                Browse all research essays, open mechanistic interpretability questions, and lab
                notes hosted on the main website.
              </p>
            </div>
            <span class="blog-arrow">Open Blog ↗</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Section IV: Record & Recognition -->
    <section class="archive-band archive-band-last" id="record">
      <div class="archive-rule"></div>
      <div class="page-container section-band-inner">
        <div class="section-kicker">03 // BACKGROUND</div>
        <h2 class="section-goldeneye-title record-heading">Record &amp; Recognition</h2>

        <div class="ledger-grid">
          <div class="ledger-col">
            <div class="ledger-subhead">Experience</div>
            <ul class="ledger-list">
              {EXPERIENCE.map((item) => (
                <li class="ledger-row">
                  <span class="ledger-period">{item.period}</span>
                  <div class="ledger-text">
                    <span class="ledger-primary">{item.role}</span>
                    <span class="ledger-secondary">{item.org}</span>
                  </div>
                </li>
              ))}
            </ul>
          </div>

          <div class="ledger-col">
            <div class="ledger-subhead">Honors &amp; Distinctions</div>
            <ul class="ledger-list">
              {RECOGNITION.map((item) => (
                <li class="ledger-row">
                  <span class="ledger-period">{item.period}</span>
                  <div class="ledger-text">
                    <span class="ledger-primary">{item.title}</span>
                    <span class="ledger-secondary">{item.detail}</span>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- 4. Bottom Bar / Black Footer from skhavin.in -->
  <footer id="siteFooter">
    <div class="footer-container" id="fContainer">
      <div class="f-logo-wrap">
        <div class="f-logo-stage">
          <a class="f-logo-metal" href="#top" id="fLogo">s+khavin</a>
          <div class="f-logo-metal-ref" aria-hidden="true">s+khavin</div>
        </div>
        <div class="f-tagline">
          Understanding how intelligent systems compute.<br />
          Building systems that perceive, remember, and reason.
        </div>
      </div>

      <div class="f-links">
        <a href="#about">About</a>
        <a href="#preprints">Preprints</a>
        <a href="https://skhavin.in/blog" target="_blank" rel="noopener noreferrer">Blog</a>
        <a href="https://openreview.net/profile?id=~S_Khavin1" target="_blank" rel="noopener noreferrer">OpenReview</a>
