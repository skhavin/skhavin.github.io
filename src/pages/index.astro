  </footer>

  <!-- Fixed Bottom Screen Blur Overlay (auto-fades over black footer) -->
  <div class="bottom-blur-overlay" id="bottomBlur" aria-hidden="true"></div>

  <script>
    const burgerBtn = document.getElementById('burgerBtn');
    const mobMenu = document.getElementById('mobMenu');

    burgerBtn?.addEventListener('click', () => {
      mobMenu?.classList.toggle('open');
    });

    mobMenu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        mobMenu.classList.remove('open');
      });
    });

    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const paperRows = document.querySelectorAll<HTMLElement>('.paper-row');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.dataset.filter || 'all';
        filterButtons.forEach((b) => b.classList.toggle('active', b === btn));
        paperRows.forEach((row) => {
          const match = target === 'all' || row.dataset.category === target;
          row.hidden = !match;
        });
      });
    });

    const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-center a[data-nav]');
    const sections = ['about', 'preprints', 'blog', 'record']
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => Boolean(el));

    if ('IntersectionObserver' in window && sections.length > 0) {
      const sectionObserver = new IntersectionObserver(
        (entries) => {
          const visible = entries.filter((e) => e.isIntersecting);
          if (visible.length === 0) return;
          visible.sort((a, b) => b.intersectionRatio - a.intersectionRatio);
          const activeId = visible[0].target.id;
          navLinks.forEach((link) => {
            link.classList.toggle('active', link.dataset.nav === activeId);
          });
        },
        { rootMargin: '-25% 0px -55% 0px', threshold: [0.05, 0.25] }
      );
      sections.forEach((sec) => sectionObserver.observe(sec));
    }

    const yrEl = document.getElementById('yr');
    if (yrEl) yrEl.textContent = String(new Date().getFullYear());

    const fContainer = document.getElementById('fContainer');
    const fLogo = document.getElementById('fLogo');
    const siteFooter = document.getElementById('siteFooter');
    const bottomBlur = document.getElementById('bottomBlur');

    if ('IntersectionObserver' in window && fContainer && fLogo) {
      const footerObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              fContainer.classList.add('reveal');
              setTimeout(() => fLogo.classList.add('shimmer'), 650);
              footerObserver.disconnect();
            }
          });
        },
        { rootMargin: '80px 0px', threshold: 0.05 }
      );
      footerObserver.observe(fContainer);
    } else {
      fContainer?.classList.add('reveal');
    }

    if ('IntersectionObserver' in window && siteFooter && bottomBlur) {
      const blurObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            bottomBlur.classList.toggle('hidden', entry.isIntersecting);
          });
        },
        { threshold: 0.02 }
      );
      blurObserver.observe(siteFooter);
    }
  </script>
</ResearchLayout>
